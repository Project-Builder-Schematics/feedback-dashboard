{
  "name": "project-builder-feedback",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:structure && npm run test:contracts && npm run test:api && npm run test:mcp && npm run test:supabase && npm run test:web && npm run test:pages && npm run test:sites",
    "test:structure": "node --test tests/monorepo-structure.test.mjs",
    "test:contracts": "tsx --test supabase/functions/tests/report-contracts.test.ts",
    "test:api": "tsx --test supabase/functions/tests/feedback-api.test.ts supabase/functions/tests/creator-api.test.ts supabase/functions/tests/rate-limit.test.ts supabase/functions/tests/tester-api.test.ts supabase/functions/tests/remote-mcp.test.ts",
    "test:mcp": "npm --workspace apps/mcp test",
    "test:supabase": "node --test tests/supabase-*.test.mjs",
    "test:web": "npm --workspace apps/web test",
    "test:pages": "node --test tests/github-pages-config.test.mjs",
    "test:sites": "npm --workspace apps/web run test:sites"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
